package main

import (
	"context"
	"fmt"
	"log"
	"os"
	"path/filepath"
	"time"

	"github.com/wailsapp/wails/v3/pkg/application"

	"github.com/SoufianoDev/OhMyFreeAI/internal/infrastructure/backup"
	"github.com/SoufianoDev/OhMyFreeAI/internal/infrastructure/sqlite"

	appconfig "github.com/SoufianoDev/OhMyFreeAI/internal/application/config"
	domainconfig "github.com/SoufianoDev/OhMyFreeAI/internal/domain/config"
)

type DashboardSnapshot struct {
	AppVersion    string                `json:"appVersion"`
	DatabaseState string                `json:"databaseState"`
	RuntimeState  string                `json:"runtimeState"`
	Config        domainconfig.Config   `json:"config"`
}

// AppService is the narrow Wails boundary. Domain and application packages do
// not import Wails types.
type BackupExportResult struct {
	Canceled bool   `json:"canceled"`
	FileName string `json:"fileName,omitempty"`
}

type BackupInspectionSnapshot struct {
	Canceled            bool      `json:"canceled"`
	FormatVersion       int       `json:"formatVersion,omitempty"`
	ApplicationVersion  string    `json:"applicationVersion,omitempty"`
	SchemaVersion       int       `json:"schemaVersion,omitempty"`
	CreatedAt           time.Time `json:"createdAt,omitempty"`
	DatabaseSizeBytes   uint64    `json:"databaseSizeBytes,omitempty"`
	DatabaseSHA256      string    `json:"databaseSha256,omitempty"`
}

type AppService struct {
	configuration appconfig.Service
	backupManager backup.Manager
	store         *sqlite.Store
}

func NewAppService(configuration appconfig.Service, backupManager backup.Manager, store *sqlite.Store) *AppService {
	return &AppService{configuration: configuration, backupManager: backupManager, store: store}
}

// ExportBackup uses a native save dialog and writes a verified .omfaibackup
// archive without overwriting an existing file.
func (s *AppService) ExportBackup() (BackupExportResult, error) {
	if s == nil || s.store == nil || s.backupManager.Migrations == nil {
		return BackupExportResult{}, fmt.Errorf("backup export is unavailable")
	}
	dialog := application.Get().Dialog.SaveFile().
		SetTitle("Export OhMyFreeAI backup").
		SetFilename("OhMyFreeAI-Backup-" + time.Now().Format("2006-01-02") + backup.ArchiveExtension).
		AddFilter("OhMyFreeAI backup", "*"+backup.ArchiveExtension)
	path, err := dialog.PromptForSingleSelection()
	if err != nil {
		return BackupExportResult{}, fmt.Errorf("select backup destination: %w", err)
	}
	if path == "" {
		return BackupExportResult{Canceled: true}, nil
	}

	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
	defer cancel()
	if err := s.backupManager.Create(ctx, s.store, path); err != nil {
		return BackupExportResult{}, fmt.Errorf("export backup: %w", err)
	}
	return BackupExportResult{FileName: filepath.Base(path)}, nil
}

// InspectBackup validates a selected archive in temporary storage. It never
// restores or modifies the live application database.
func (s *AppService) InspectBackup() (BackupInspectionSnapshot, error) {
	if s == nil || s.backupManager.Migrations == nil {
		return BackupInspectionSnapshot{}, fmt.Errorf("backup inspection is unavailable")
	}
	dialog := application.Get().Dialog.OpenFile().
		SetTitle("Inspect OhMyFreeAI backup").
		AddFilter("OhMyFreeAI backup", "*"+backup.ArchiveExtension)
	path, err := dialog.PromptForSingleSelection()
	if err != nil {
		return BackupInspectionSnapshot{}, fmt.Errorf("select backup archive: %w", err)
	}
	if path == "" {
		return BackupInspectionSnapshot{Canceled: true}, nil
	}

	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
	defer cancel()
	manifest, err := s.backupManager.Inspect(ctx, path)
	if err != nil {
		return BackupInspectionSnapshot{}, fmt.Errorf("inspect backup: %w", err)
	}
	record := manifest.Files[0]
	return BackupInspectionSnapshot{
		FormatVersion:      manifest.FormatVersion,
		ApplicationVersion: manifest.ApplicationVersion,
		SchemaVersion:      manifest.SchemaVersion,
		CreatedAt:          manifest.CreatedAt,
		DatabaseSizeBytes:  record.Size,
		DatabaseSHA256:     record.SHA256,
	}, nil
}

// GetSnapshot returns only verified local application state. It does not
// claim that a remote runtime, gateway or model is running.
func (s *AppService) GetSnapshot() (DashboardSnapshot, error) {
	if s == nil {
		return DashboardSnapshot{}, fmt.Errorf("application service is unavailable")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	cfg, err := s.configuration.Load(ctx)
	if err != nil {
		if marker := os.Getenv("OMFAI_WEBVIEW_SMOKE_MARKER"); marker != "" {
			_ = os.WriteFile(marker, []byte("GetSnapshot failed: "+err.Error()+"\n"), 0o600)
		}
		return DashboardSnapshot{}, fmt.Errorf("load application snapshot: %w", err)
	}
	snapshot := DashboardSnapshot{
		AppVersion:    "0.1.0",
		DatabaseState: "ready",
		RuntimeState:  "not_connected",
		Config:        cfg,
	}
	// The opt-in marker lets CI prove that the frontend actually invoked this
	// Go method through the generated Wails bridge. It is inert in normal runs.
	if marker := os.Getenv("OMFAI_WEBVIEW_SMOKE_MARKER"); marker != "" {
		count := 1
		if previous, readErr := os.ReadFile(marker); readErr == nil {
			var priorCount int
			if _, scanErr := fmt.Sscanf(string(previous), "GetSnapshot success count=%d", &priorCount); scanErr == nil {
				count = priorCount + 1
			}
		}
		value := fmt.Sprintf("GetSnapshot success count=%d\n", count)
		if err := os.WriteFile(marker, []byte(value), 0o600); err != nil {
			return DashboardSnapshot{}, fmt.Errorf("write WebView smoke marker: %w", err)
		}
	}
	log.Printf("native snapshot ready: database=%s runtime=%s", snapshot.DatabaseState, snapshot.RuntimeState)
	return snapshot, nil
}

// SaveConfig persists validated application settings. Secret values are not
// accepted here; the configuration model contains secret references only.
func (s *AppService) SaveConfig(cfg domainconfig.Config) error {
	if s == nil {
		return fmt.Errorf("application service is unavailable")
	}
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := s.configuration.Save(ctx, cfg); err != nil {
		return fmt.Errorf("save application configuration: %w", err)
	}
	return nil
}
