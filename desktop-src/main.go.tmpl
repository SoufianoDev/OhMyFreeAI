package main

import (
	"context"
	"embed"
	"errors"
	"fmt"
	"io"
	"log"
	"os"
	"path/filepath"
	"runtime"
	"time"

	"github.com/wailsapp/wails/v3/pkg/application"

	appcli "github.com/SoufianoDev/OhMyFreeAI/internal/application/cli"
	appconfig "github.com/SoufianoDev/OhMyFreeAI/internal/application/config"
	"github.com/SoufianoDev/OhMyFreeAI/internal/infrastructure/backup"
	"github.com/SoufianoDev/OhMyFreeAI/internal/infrastructure/sqlite"
	"github.com/SoufianoDev/OhMyFreeAI/internal/version"
	"github.com/SoufianoDev/OhMyFreeAI/migrations"
)

//go:embed all:frontend/dist
var assets embed.FS

func main() {
	invocation, err := appcli.Parse(os.Args[1:])
	if err != nil {
		fmt.Fprintf(os.Stderr, "OhMyFreeAI: %v\nTry 'OhMyFreeAI --help'.\n", err)
		os.Exit(2)
	}

	switch invocation.Command {
	case appcli.ShowHelp:
		fmt.Fprint(os.Stdout, appcli.Usage)
	case appcli.ShowVersion:
		fmt.Fprintf(os.Stdout, "OhMyFreeAI %s\n", version.Current)
	case appcli.RunDoctor:
		if err := runDoctor(os.Stdout); err != nil {
			fmt.Fprintf(os.Stderr, "OhMyFreeAI doctor: %v\n", err)
			os.Exit(1)
		}
	case appcli.BackupExport, appcli.BackupInspect:
		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
		err := runBackupCommand(ctx, invocation, os.Stdout)
		cancel()
		if err != nil {
			fmt.Fprintf(os.Stderr, "OhMyFreeAI backup: %v\n", err)
			os.Exit(1)
		}
	case appcli.LaunchGUI:
		if err := run(); err != nil {
			log.Fatal(err)
		}
	default:
		fmt.Fprintf(os.Stderr, "OhMyFreeAI: unsupported command %q\n", invocation.Command)
		os.Exit(2)
	}
}

// runDoctor reports local environment facts only. It deliberately does not
// infer database integrity, runtime connectivity, GPU availability or model
// readiness from the existence of files.
func runDoctor(output io.Writer) error {
	configDirectory, err := os.UserConfigDir()
	if err != nil {
		return fmt.Errorf("resolve application config directory: %w", err)
	}
	databasePath := filepath.Join(configDirectory, "OhMyFreeAI", "state.db")
	databaseState := "not created"
	info, err := os.Lstat(databasePath)
	switch {
	case err == nil:
		if !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 {
			return fmt.Errorf("database path is not a regular file")
		}
		databaseState = "present (integrity not checked)"
	case os.IsNotExist(err):
		// A first launch is a valid state; doctor must not create the database.
	case err != nil:
		return fmt.Errorf("inspect database path: %w", err)
	}

	_, err = fmt.Fprintf(output,
		"OhMyFreeAI doctor\nVersion: %s\nPlatform: %s/%s\nGo runtime: %s\nDatabase: %s\nDatabase file: %s\n",
		version.Current, runtime.GOOS, runtime.GOARCH, runtime.Version(), databaseState, databasePath,
	)
	return err
}

func run() error {
	configDirectory, err := os.UserConfigDir()
	if err != nil {
		return fmt.Errorf("resolve application config directory: %w", err)
	}
	databasePath := filepath.Join(configDirectory, "OhMyFreeAI", "state.db")

	startupContext, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	store, err := sqlite.Open(startupContext, databasePath)
	if err != nil {
		return fmt.Errorf("open application database: %w", err)
	}
	if err := store.Migrate(startupContext, migrations.Files, "."); err != nil {
		_ = store.Close()
		return fmt.Errorf("migrate application database: %w", err)
	}

	storeController := sqlite.NewStoreController(store)
	defer func() {
		closeContext, closeCancel := context.WithTimeout(context.Background(), 30*time.Second)
		defer closeCancel()
		if err := storeController.Close(closeContext); err != nil {
			log.Printf("close application database through controller: %v", err)
		}
	}()

	configuration := appconfig.Service{Repository: storeController}
	backupManager := backup.Manager{ApplicationVersion: version.Current, Migrations: migrations.Files, MigrationDir: "."}
	service := NewAppService(configuration, backupManager, storeController)

	app := application.New(application.Options{
		Name:        "OhMyFreeAI",
		Description: "Free local-first AI workspace",
		Services: []application.Service{
			application.NewService(service),
		},
		Assets: application.AssetOptions{
			Handler: application.AssetFileServerFS(assets),
		},
	})

	app.Window.NewWithOptions(application.WebviewWindowOptions{
		Title:            "OhMyFreeAI",
		Width:            1280,
		Height:           820,
		BackgroundColour: application.NewRGB(247, 248, 250),
		URL:              "/",
	})

	if err := app.Run(); err != nil {
		return fmt.Errorf("run desktop application: %w", err)
	}
	return nil
}


type localBackupOperations struct {
	manager         backup.Manager
	storeController *sqlite.StoreController
}

func (operations localBackupOperations) Export(ctx context.Context, destination string) error {
	if operations.storeController == nil {
		return fmt.Errorf("local application database is unavailable")
	}
	return operations.manager.CreateWithStoreController(ctx, operations.storeController, destination)
}

func (operations localBackupOperations) Inspect(ctx context.Context, archivePath string) (appcli.BackupInspection, error) {
	manifest, err := operations.manager.Inspect(ctx, archivePath)
	if err != nil {
		return appcli.BackupInspection{}, err
	}
	if len(manifest.Files) != 1 {
		return appcli.BackupInspection{}, fmt.Errorf("validated backup manifest has an unexpected file count")
	}
	record := manifest.Files[0]
	return appcli.BackupInspection{
		FormatVersion:      manifest.FormatVersion,
		ApplicationVersion: manifest.ApplicationVersion,
		SchemaVersion:      manifest.SchemaVersion,
		CreatedAt:          manifest.CreatedAt,
		DatabaseSizeBytes:  record.Size,
		DatabaseSHA256:     record.SHA256,
	}, nil
}

// runBackupCommand is the CLI composition boundary. Export opens only an
// existing database and never creates a first-run database or runs migrations.
func runBackupCommand(ctx context.Context, invocation appcli.Invocation, output io.Writer) (result error) {
	manager := backup.Manager{ApplicationVersion: version.Current, Migrations: migrations.Files, MigrationDir: "."}
	operations := localBackupOperations{manager: manager}
	if invocation.Command == appcli.BackupExport {
		configDirectory, err := os.UserConfigDir()
		if err != nil {
			return fmt.Errorf("resolve application config directory: %w", err)
		}
		databasePath := filepath.Join(configDirectory, "OhMyFreeAI", "state.db")
		info, err := os.Lstat(databasePath)
		if err != nil {
			if errors.Is(err, os.ErrNotExist) {
				return fmt.Errorf("application database does not exist; launch OhMyFreeAI once before exporting")
			}
			return fmt.Errorf("inspect application database: %w", err)
		}
		if !info.Mode().IsRegular() || info.Mode()&os.ModeSymlink != 0 {
			return fmt.Errorf("application database path is not a regular file")
		}
		store, err := sqlite.OpenExisting(ctx, databasePath)
		if err != nil {
			return fmt.Errorf("open existing application database: %w", err)
		}
		operations.storeController = sqlite.NewStoreController(store)
		defer func() {
			closeContext, closeCancel := context.WithTimeout(context.Background(), 30*time.Second)
			defer closeCancel()
			if closeErr := operations.storeController.Close(closeContext); closeErr != nil && result == nil {
				result = fmt.Errorf("close application database after backup: %w", closeErr)
			}
		}()
	}
	return appcli.RunBackup(ctx, output, invocation, operations)
}